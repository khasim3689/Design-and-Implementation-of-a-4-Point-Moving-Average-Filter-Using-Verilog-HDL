module filter_tb;
reg clk;
reg reset;
reg [7:0] data_in;
wire [7:0] data_out;

// Instantiate DUT
filter uut (
    .clk(clk),
    .reset(reset),
    .data_in(data_in),
    .data_out(data_out)
);

// Clock generation
initial
begin
    clk = 0;
    forever #5 clk = ~clk;
end

// Test inputs
initial
begin
    reset = 1;
    data_in = 8'd0;

    // Reset
    #12;
    reset = 0;

    // Apply input samples
    #8  data_in = 8'd10;
    #10 data_in = 8'd20;
    #10 data_in = 8'd30;
    #10 data_in = 8'd40;
    #10 data_in = 8'd50;
    #10 data_in = 8'd60;
    #10 data_in = 8'd70;
    #10 data_in = 8'd80;

    #20;
    $finish;
end


endmodule
